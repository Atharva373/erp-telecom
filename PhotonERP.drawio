        <mxCell id="G5cn_bHqMBYBkkwGZiA4-63" value="Product Catalogue contains&lt;br style=&quot;font-size: 14px;&quot;&gt;all the available Products and Service&lt;br style=&quot;font-size: 14px;&quot;&gt;available to the end customers&lt;br&gt;After successful creation of Order, Contracts are created&lt;br&gt;once payment is successful, the contracts&lt;br&gt;are active and the Master Agreement is&lt;br&gt;Created." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="541" y="659" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="G5cn_bHqMBYBkkwGZiA4-64" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;One Contract is mapped to exactly&lt;br&gt;one Product.&lt;br&gt;Contract is an agreement between the&lt;br&gt;Customer and the Company for &lt;br&gt;terms and duration&lt;br&gt;of the consumable products/ services.&lt;br&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="969" y="709" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="G5cn_bHqMBYBkkwGZiA4-65" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Master Agreement is the Umbrella for all the&lt;br&gt;Contract and Product pair and acts a collective&lt;br&gt;agreement between the Customer&lt;br&gt;and the Company.&lt;br&gt;invoices can be billed and invoiced based&lt;br&gt;off of the Master Agreement.&lt;br&gt;NOTE: One Customer can have multiple &lt;br&gt;Master Agreements. Based on the current design&lt;br&gt;Master Agreements are created on the basis of&amp;nbsp;&lt;br&gt;PREPAID and POSTPAID&lt;br&gt;&lt;br&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1258" y="639" width="330" height="200" as="geometry" />
        </mxCell>

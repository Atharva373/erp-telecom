        <mxCell id="-M26eCFNpYLjsYz4TJt7-3" parent="-M26eCFNpYLjsYz4TJt7-2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="1. Profit and Cost centers.&lt;div&gt;2. Accounting related reports refinement&lt;/div&gt;" vertex="1">

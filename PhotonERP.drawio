        <mxCell id="fI3IS1DAUvFwtO677m2t-77" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;PREPAID VS POSTPAID Revenue recognition map&lt;br&gt;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;table border=&quot;1&quot; style=&quot;border: 1px solid rgb(0, 0, 0); border-collapse: collapse;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Account Type&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Prepaid Impact&lt;/font&gt;&lt;/th&gt;&lt;th&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Postpaid Impact&lt;/font&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Bank (Asset)&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;↑ when payment received&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;↑ when payment received (later)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Accounts Receivable (Asset)&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td border=&quot;1&quot; style=&quot;border-collapse: collapse;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;❌ Never used&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;↑ when usage triggers invoice (or real-time AR increment)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Unearned Revenue (Liability)&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;↑ when payment received  ↓ when usage occurs  ↓ on expiry&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;❌ Not used&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Revenue (Equity)&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Recognized &lt;strong&gt;only on usage&lt;/strong&gt;&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Recognized &lt;strong&gt;on usage or invoice&lt;/strong&gt;&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Breakage Revenue (Equity)&lt;/font&gt;&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Used if unused prepaid expires&lt;/font&gt;&lt;/td&gt;&lt;td&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;❌ Not applicable&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">

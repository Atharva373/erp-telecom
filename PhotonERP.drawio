        <mxCell id="PMdaN-nI7vNafcA2DIiJ-300" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;To-do&lt;br&gt;1. Enable posting periods, open and close logc&lt;br&gt;2. Fiscal year variant&lt;br&gt;3. Profit center and COst center / controlling area if possible !&lt;br&gt;4. Accrued vs Deferred revenue model&lt;/font&gt;" vertex="1">
          <mxGeometry height="360" width="270" x="-2130" y="1610" as="geometry" />
        </mxCell>
      </root>

        </mxCell>
        <mxCell id="PMdaN-nI7vNafcA2DIiJ-251" parent="PMdaN-nI7vNafcA2DIiJ-240" style="whiteSpace=wrap;html=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Cash in Hand&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="220" x="330" y="226" as="geometry" />

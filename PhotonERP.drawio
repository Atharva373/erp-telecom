          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-29" parent="1XOBq6Fh20NvrSz5hWdA-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" value="Balance Sheet Statements" vertex="1">
          <mxGeometry height="60" width="130" x="895" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-28" parent="1XOBq6Fh20NvrSz5hWdA-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span&gt;Trial Balance Report&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="130" x="80" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-8" parent="1XOBq6Fh20NvrSz5hWdA-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span&gt;General Ledger Report&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="330" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-42" edge="1" parent="1XOBq6Fh20NvrSz5hWdA-1" source="1XOBq6Fh20NvrSz5hWdA-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="1XOBq6Fh20NvrSz5hWdA-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-10" parent="1XOBq6Fh20NvrSz5hWdA-1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span&gt;Profit &amp;amp; Loss Statements&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="130" x="590" y="70" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-31" collapsed="1" parent="1XOBq6Fh20NvrSz5hWdA-1" style="swimlane;whiteSpace=wrap;html=1;" value="Description" vertex="1">
          <mxGeometry height="30" width="140" x="10" y="180" as="geometry">
            <mxRectangle height="450" width="300" x="10" y="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-30" parent="1XOBq6Fh20NvrSz5hWdA-31" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Trial Balance is a summarized validation report that shows the total debits, total credits, and net balance of every ledger account for a given period, ensuring that the books are arithmetically correct (total debits = total credits).&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Purpose&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Validate ledger integrity&lt;/li&gt;&lt;li&gt;Detect posting or configuration errors&lt;/li&gt;&lt;li&gt;Starting point for audits and financial statements&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Key characteristics&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Aggregated view&lt;/li&gt;&lt;li&gt;Period-based&lt;/li&gt;&lt;li&gt;No transaction-level detail&lt;/li&gt;&lt;li&gt;Diagnostic, not explanatory&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="290" x="5" y="30" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-33" edge="1" parent="1XOBq6Fh20NvrSz5hWdA-1" source="1XOBq6Fh20NvrSz5hWdA-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.447;entryY=0.002;entryDx=0;entryDy=0;entryPerimeter=0;" target="1XOBq6Fh20NvrSz5hWdA-31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-34" collapsed="1" parent="1XOBq6Fh20NvrSz5hWdA-1" style="swimlane;whiteSpace=wrap;html=1;" value="Description" vertex="1">
          <mxGeometry height="30" width="140" x="260" y="180" as="geometry">
            <mxRectangle height="450" width="300" x="260" y="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-35" parent="1XOBq6Fh20NvrSz5hWdA-34" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;General Ledger is a detailed, chronological report that lists all journal entry lines posted to a specific account over a period, showing how the account balance evolved over time.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Explain why an account has a certain balance&lt;/li&gt;&lt;li&gt;Provide traceability to source transactions&lt;/li&gt;&lt;li&gt;Support audits, reconciliations, and investigations&lt;br&gt;&lt;br&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Key characteristics&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Account-centric&lt;/li&gt;&lt;li&gt;Transaction-level detail&lt;/li&gt;&lt;li&gt;Ordered by posting date&lt;/li&gt;&lt;li&gt;Includes running balance&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="290" x="5" y="30" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-36" collapsed="1" parent="1XOBq6Fh20NvrSz5hWdA-1" style="swimlane;whiteSpace=wrap;html=1;" value="Description" vertex="1">
          <mxGeometry height="30" width="140" x="520" y="180" as="geometry">
            <mxRectangle height="450" width="300" x="520" y="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-37" parent="1XOBq6Fh20NvrSz5hWdA-36" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;Balance Sheet is a point-in-time financial statement that presents the company’s assets, liabilities, and equity as of a specific posting period, reflecting the cumulative financial position of the business.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Show what the company owns and owes&lt;/li&gt;&lt;li&gt;Measure financial stability and solvency&lt;/li&gt;&lt;li&gt;Used by management, auditors, and regulators&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Key characteristics&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Snapshot (not a range)&lt;/li&gt;&lt;li&gt;Cumulative balances up to period end&lt;/li&gt;&lt;li&gt;Covers ASSET, LIABILITY, EQUITY accounts&lt;/li&gt;&lt;li&gt;Must satisfy: Assets = Liabilities + Equity&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="290" x="5" y="30" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-38" collapsed="1" parent="1XOBq6Fh20NvrSz5hWdA-1" style="swimlane;whiteSpace=wrap;html=1;" value="Description" vertex="1">
          <mxGeometry height="30" width="140" x="810" y="180" as="geometry">
            <mxRectangle height="450" width="300" x="695" y="180" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-39" parent="1XOBq6Fh20NvrSz5hWdA-38" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;Profit &amp;amp; Loss is a period-based financial statement that summarizes revenues and expenses incurred during a defined time window, showing the company’s operational performance and net profit or loss.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Purpose&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Measure business performance&lt;/li&gt;&lt;li&gt;Analyze revenue and cost behavior&lt;/li&gt;&lt;li&gt;Feed retained earnings in Balance Sheet&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;Key characteristics&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Movement-based (not cumulative forever)&lt;/li&gt;&lt;li&gt;Covers REVENUE and EXPENSE accounts&lt;/li&gt;&lt;li&gt;Period range (e.g., Month, Quarter, Year)&lt;/li&gt;&lt;li&gt;Net Result = Revenue − Expenses&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="400" width="290" x="5" y="30" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-41" edge="1" parent="1XOBq6Fh20NvrSz5hWdA-1" source="1XOBq6Fh20NvrSz5hWdA-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.467;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="1XOBq6Fh20NvrSz5hWdA-34">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1XOBq6Fh20NvrSz5hWdA-44" parent="1XOBq6Fh20NvrSz5hWdA-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;b&gt;Mental model (very compact)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Trial Balance → “Do the books balance?”--&amp;gt;&amp;nbsp;&lt;strong data-start=&quot;3061&quot; data-end=&quot;3074&quot;&gt;Integrity&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;General Ledger → “How did we get here?” --&amp;gt;&amp;nbsp;&lt;strong data-start=&quot;3084&quot; data-end=&quot;3102&quot;&gt;Explanability&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;Balance Sheet → “Where do we stand?” --&amp;gt;&amp;nbsp;&lt;strong data-start=&quot;3112&quot; data-end=&quot;3124&quot;&gt;Position&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;Profit &amp;amp; Loss → “How did we perform?” --&amp;gt;&amp;nbsp;&lt;strong data-start=&quot;3134&quot; data-end=&quot;3149&quot;&gt;Performance&lt;/strong&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="390" x="400" y="470" as="geometry" />
        </mxCell>
        <mxCell id="fJU4gZ0ZGuq_DhPipGDS-1" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Revenue Recognition Jobs&lt;/font&gt;" vertex="1">
          <mxGeometry height="890" width="1660" x="-500" y="-70" as="geometry" />
        </mxCell>
        <mxCell id="fJU4gZ0ZGuq_DhPipGDS-4" parent="fJU4gZ0ZGuq_DhPipGDS-1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Job Technical Execution&lt;/font&gt;" vertex="1">
          <mxGeometry height="610" width="655" x="950" y="60" as="geometry" />
        </mxCell>
        <mxCell id="fJU4gZ0ZGuq_DhPipGDS-5" parent="fJU4gZ0ZGuq_DhPipGDS-4" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ┌──────────────────────────┐&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&amp;nbsp; &amp;nbsp;RevenueSchedule Table&amp;nbsp; &amp;nbsp;│&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │ (What should be recognized)│&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; └─────────────┬────────────┘&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ▼&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ┌─────────────────────────────────┐&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │ RevenueRecognitionExecutor&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │ (Single execution authority)&amp;nbsp; &amp;nbsp; &amp;nbsp;│&lt
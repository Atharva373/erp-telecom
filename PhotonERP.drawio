        <mxCell id="PMdaN-nI7vNafcA2DIiJ-252" parent="PMdaN-nI7vNafcA2DIiJ-240" style="whiteSpace=wrap;html=1;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Accounts Receivable&lt;/font&gt;&lt;/b&gt;" vertex="1">

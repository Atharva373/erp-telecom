  <diagram id="-hfLJTseffFnvuK8mHQ3" name="CRM and Finance Link">
    <mxGraphModel dx="1426" dy="1851" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="uD9aJ76kWfOtOLw8fU9--3" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=60;" value="&lt;h1 style=&quot;text-align: left; margin-top: 0px;&quot;&gt;PHOTON ERP - CRM AND FINANCE LINK&lt;/h1&gt;" vertex="1">
          <mxGeometry height="780" width="840" x="450" y="-1040" as="geometry" />
        </mxCell>
        <mxCell id="uD9aJ76kWfOtOLw8fU9--1" parent="uD9aJ76kWfOtOLw8fU9--3" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;This section describes the CRM side of Photon for the Customers/Businesses interacting with Photon. We have 2 key entities:&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;1. &lt;b&gt;BusinessEntity &lt;/b&gt;- Standalone Generic entity for representing the Business / Individual customer.&lt;br&gt;&lt;br&gt;2. &lt;b&gt;FinanceProfile &lt;/b&gt;- Linkage from a Business entity to Finance parameters like:&lt;/font&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- AR/AP&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;- Which &lt;/span&gt;&lt;strong data-start=&quot;662&quot; data-end=&quot;684&quot; style=&quot;background-color: transparent;&quot;&gt;GL control account&lt;/strong&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; is used?&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- Credit limits&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- Currency&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- Payment Terms&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- Dunning&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- Posting behavior&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;- Collective invoicing.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;font-size: 15px; background-color: transparent;&quot;&gt;Cardinality&lt;/b&gt;&lt;span style=&quot;font-size: 15px; background-color: transparent;&quot;&gt;:&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;BusinessEntity 1 ──── N FinanceProfiles&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;FinanceProfile &lt;/b&gt;is strictly linked to Subledgers and all the finance processes that directly affect the Subledger. It does not directly touch the CRM part of things.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="550" width="750" x="45" y="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

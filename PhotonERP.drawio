        <mxCell id="qEeMhJDLQFBE_HY2ijhZ-66" parent="qEeMhJDLQFBE_HY2ijhZ-19" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Old Period closure time + Hard Lock days in config&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="340" x="1725" y="700" as="geometry" />
        </mxCell>
        <mxCell id="qEeMhJDLQFBE_HY2ijhZ-67" parent="qEeMhJDLQFBE_HY2ijhZ-19" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;li data-start=&quot;35&quot; data-end=&quot;181&quot;&gt;&lt;p data-start=&quot;37&quot; data-end=&quot;181&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Definition:&lt;/b&gt; Posting periods are defined time intervals (e.g., monthly, quarterly, yearly) used to record and report accounting transactions&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;37&quot; data-end=&quot;181&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Purpose: &lt;/b&gt;They ensure transactions are recorded in the correct accounting period for accurate financial reporting.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;37&quot; data-end=&quot;181&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Types: &lt;/b&gt;Common posting periods include months, quarters, and fiscal years.&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="130" width="860" x="120" y="40" as="geometry" />
        </mxCell>
